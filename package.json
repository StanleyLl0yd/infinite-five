{
  "name": "infinite-five",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-game-core-wasm.mjs && vite",
    "dev:tauri": "vite",
    "build": "npm run build:web",
    "build:web": "node scripts/build-game-core-wasm.mjs --require-opt && tsc --noEmit && vite build && node scripts/verify-frontend-release.mjs",
    "build:tauri": "node scripts/clean-game-core-wasm.mjs && tsc --noEmit && vite build && node scripts/verify-frontend-release.mjs --native",
    "build:core": "node scripts/build-game-core-wasm.mjs --require-opt",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai-lab": "cargo test --manifest-path crates/game-core/Cargo.toml expert_and_hard_self_play_remains_legal representative_expert_position_reports_search_diagnostics -- --nocapture",
    "test:core": "cargo test --manifest-path crates/game-core/Cargo.toml",
    "typecheck": "tsc --noEmit --pretty false",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
